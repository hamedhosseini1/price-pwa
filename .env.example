# ── price-pwa environment ──────────────────────────────────────────────
# Free key from https://brsapi.ir/tsetmc-exchange-free-bourse-api-key-request/
# (1500 req/day). Without it the app falls back to tgju + coingecko + ECB.
BRSAPI_KEY=

# Optional: TwelveData key for oil cross-check (https://twelvedata.com, free tier)
TWELVEDATA_KEY=

# Enable ONLY with Bonbast permission (their ToS forbids scraping/redistribution)
ENABLE_BONBAST=0

# Snapshot refresh interval (ms) for keyless sources (tgju/coingecko/ECB). Min 10000.
REFRESH_MS=45000

# BrsApi refresh interval (ms). QUOTA MATH (free tier = 1500 req/day):
# 2 calls per BrsApi refresh (Gold_Currency + Commodity).
# 150s interval → 576 refreshes/day → 1152 calls/day ≈ 77% of quota
# (~350 spare for restarts; history/health routes never touch BrsApi).
# On HTTP 429 the source auto-suspends for 15 min. See docs/SOURCES.md.
BRSAPI_REFRESH_MS=150000

# TwelveData (optional oil cross-check) refresh interval (ms). Free tier =
# 800 credits/day; 2 symbols × 288 refreshes/day (5min) = 576/day.
TWELVEDATA_REFRESH_MS=300000

# Outlier rejection threshold (% deviation from median to drop a quote)
OUTLIER_PCT=2.5
